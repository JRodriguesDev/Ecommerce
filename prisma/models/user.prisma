model User {
    id String @id @default(uuid())
    name String?
    password String?
    email String @unique
    emailVerified DateTime?
    mainImage String?
    image String?
    googleImage String?
    discordImage String?
    accounts  Account[]
    twoFactorEnabled Boolean @default(false)
    twoFactorSecret  String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("users")
}